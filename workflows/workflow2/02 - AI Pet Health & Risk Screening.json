          "id": "IWQ3lgGaQrHp2JTO",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawContent = $input.first().json.choices[0].message.content;\n\nlet riskLevel = \"Pending Review\";\nlet reason = \"Could not parse AI response - flagged for manual review as a safety precaution.\";\nlet parseSucceeded = false;\n\ntry {\n  const parsed = JSON.parse(rawContent);\n  if (parsed.riskLevel && [\"Low\", \"Medium\", \"High\"].includes(parsed.riskLevel)) {\n    riskLevel = parsed.riskLevel;\n    reason = parsed.reason || \"No reason provided.\";\n    parseSucceeded = true;\n  }\n} catch (error) {\n  // Parsing failed — riskLevel stays \"Pending Review\" (safe default)\n}\n\nreturn [{\n  json: {\n    riskLevel,\n    reason,\n    parseSucceeded\n  }\n}];"
      },

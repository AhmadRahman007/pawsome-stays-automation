        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a pet boarding safety screener. Read the health/behavior notes for a pet and classify the risk level for boarding staff. Respond ONLY with valid JSON in this exact format, no other text: {\\\"riskLevel\\\": \\\"Low\\\" or \\\"Medium\\\" or \\\"High\\\", \\\"reason\\\": \\\"a short one-sentence explanation\\\"}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $('Webhook').item.json.body.healthNotes }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
